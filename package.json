  "name": "notification-gateway",
  "version": "1.0.0",
  "description": "A microservice for multi-channel notifications (Email, Telegram, Discord).",
  "keywords": [],
  "homepage": "https://github.com/fakeowl1/notification-gateway#readme",
  "bugs": {
